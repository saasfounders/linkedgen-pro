# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/linkedgen_pro

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Apollo API
APOLLO_API_KEY=your-apollo-api-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-token
